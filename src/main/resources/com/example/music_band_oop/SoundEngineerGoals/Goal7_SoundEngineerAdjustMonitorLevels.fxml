
<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.effect.DropShadow?>
        <?import javafx.scene.layout.*?>
        <?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: linear-gradient(to bottom right, #0d1b2a, #1b263b, #415a77);"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.music_band_oop.Controller.FXMLControllerForUser1.SE_Goal7_ViewController">

    <!-- MAIN SCROLLPANE -->
    <ScrollPane fitToWidth="true"
                fitToHeight="true"
                pannable="true"
                prefHeight="720.0"
                prefWidth="1280.0"
                style="-fx-background: transparent; -fx-background-color: transparent;">

        <content>

            <VBox alignment="TOP_CENTER"
                  spacing="15.0"
                  style="-fx-padding: 20;">

                <!-- MAIN CARD -->
                <VBox maxWidth="1100.0"
                      spacing="18.0"
                      style="-fx-background-color: #e0e1dd;
                             -fx-background-radius: 12;
                             -fx-padding: 25;">

                    <effect>
                        <DropShadow color="#00000044"
                                    radius="20"
                                    spread="0.08"/>
                    </effect>

                    <!-- HEADER -->
                    <VBox alignment="CENTER" spacing="6">

                        <Label text="Sound Engineer"
                               textFill="#415a77">
                            <font>
                                <Font name="System Bold" size="13"/>
                            </font>
                        </Label>

                        <Label text="Monitor Control Dashboard"
                               textFill="#0d1b2a">
                            <font>
                                <Font name="System Bold Italic" size="24"/>
                            </font>
                        </Label>

                        <Separator maxWidth="1000"/>

                        <Label text="Manage stage monitor mixes, levels, panning, and performer routing."
                               wrapText="true"
                               textAlignment="CENTER"
                               textFill="#415a77"/>
                    </VBox>

                    <!-- STATUS -->
                    <Label fx:id="feedbackLabel"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           maxWidth="1000"/>

                    <!-- FORM SECTION -->
                    <HBox spacing="20">

                        <!-- LEFT SIDE -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS">

                            <Label text="Channel & Performer">
                                <font>
                                    <Font name="System Bold" size="15"/>
                                </font>
                            </Label>

                            <GridPane hgap="10" vgap="10">

                                <columnConstraints>
                                    <ColumnConstraints percentWidth="35"/>
                                    <ColumnConstraints percentWidth="65"/>
                                </columnConstraints>

                                <Label text="Channel Name:*"
                                       GridPane.rowIndex="0"/>

                                <TextField fx:id="MonitorChannelTextField"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0"/>

                                <Label text="Performer Name:*"
                                       GridPane.rowIndex="1"/>

                                <TextField fx:id="PerformerTextField"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>

                                <Label text="Role:*"
                                       GridPane.rowIndex="2"/>

                                <ComboBox fx:id="RoleComboBox"
                                          maxWidth="Infinity"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="2"/>
                            </GridPane>
                        </VBox>

                        <!-- RIGHT SIDE -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS">

                            <Label text="Level & Routing">
                                <font>
                                    <Font name="System Bold" size="15"/>
                                </font>
                            </Label>

                            <GridPane hgap="10" vgap="10">

                                <columnConstraints>
                                    <ColumnConstraints percentWidth="35"/>
                                    <ColumnConstraints percentWidth="65"/>
                                </columnConstraints>

                                <Label text="Current Level:"
                                       GridPane.rowIndex="0"/>

                                <Slider fx:id="CurrentLevelSlider"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="0"/>

                                <Label text="Target Level:"
                                       GridPane.rowIndex="1"/>

                                <Slider fx:id="TargetLevelSlider"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="1"/>

                                <Label text="Pan:"
                                       GridPane.rowIndex="2"/>

                                <Slider fx:id="PanSlider"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="2"/>
                            </GridPane>
                        </VBox>
                    </HBox>

                    <!-- NOTES -->
                    <VBox spacing="8">

                        <Label text="Engineer Notes:"/>

                        <TextArea fx:id="notesTextArea"
                                  prefRowCount="3"
                                  wrapText="true"/>
                    </VBox>

                    <!-- BUTTONS -->
                    <FlowPane hgap="10"
                              vgap="10"
                              alignment="CENTER">

                        <Button text="Add Channel"
                                prefWidth="140"
                                onAction="#AddToTheTableButtonOnAction"/>

                        <Button text="Update"
                                prefWidth="120"
                                onAction="#handleUpdate"/>

                        <Button text="Clear"
                                prefWidth="120"
                                onAction="#handleClear"/>

                        <Button text="Delete"
                                prefWidth="120"
                                onAction="#handleDelete"/>

                        <Button text="Save Log"
                                prefWidth="140"
                                onAction="#SaveLogButtonOnAction"/>
                    </FlowPane>

                    <!-- SEARCH -->
                    <HBox spacing="10"
                          alignment="CENTER_LEFT">

                        <Label text="Monitor Mix Channels"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <TextField fx:id="searchField"
                                   prefWidth="220"
                                   promptText="Search..."/>

                        <Button text="Search"
                                onAction="#handleSearch"/>

                        <Button text="Reset"
                                onAction="#handleResetSearch"/>
                    </HBox>

                    <!-- TABLE -->
                    <TableView fx:id="MonitorTableView"
                               prefHeight="300"
                               columnResizePolicy="CONSTRAINED_RESIZE_POLICY">

                        <columns>

                            <TableColumn fx:id="TimeCol"
                                         text="Timestamp"/>

                            <TableColumn fx:id="MonitorChannelCol"
                                         text="Channel"/>

                            <TableColumn fx:id="PerformerCol"
                                         text="Performer"/>

                            <TableColumn fx:id="RoleCol"
                                         text="Role"/>

                            <TableColumn fx:id="CurrentLevelCol"
                                         text="Level"/>

                            <TableColumn fx:id="TargetLevelCol"
                                         text="Target"/>

                            <TableColumn fx:id="PanCol"
                                         text="Pan"/>

                            <TableColumn fx:id="MuteCol"
                                         text="Mute"/>

                            <TableColumn fx:id="SoloCol"
                                         text="Solo"/>

                            <TableColumn fx:id="StatusCol"
                                         text="Status"/>
                        </columns>
                    </TableView>

                    <!-- FOOTER -->
                    <HBox alignment="CENTER_RIGHT">

                        <Button text="← Back to Dashboard"
                                prefWidth="180"
                                prefHeight="40"
                                onAction="#DashboardButtonOnAction"
                                style="-fx-background-color: #1b263b;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 6;"/>
                    </HBox>
                </VBox>

                <!-- COPYRIGHT -->
                <Label text="© 2026 Music Band OOP System"
                       textFill="#e0e1dd88"/>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>

