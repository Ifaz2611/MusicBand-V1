<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="780.0" prefWidth="1100.0"
            style="-fx-background-color: linear-gradient(to bottom right, #0d1b2a, #1b263b, #415a77);"
            xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.music_band_oop.Controller.FXMLControllerForUser1.SE_Goal2_ViewController">

    <VBox alignment="CENTER" layoutX="50.0" layoutY="30.0" prefWidth="1000.0" spacing="0.0">

        <!-- Header Card -->
        <VBox alignment="CENTER" spacing="6.0"
              style="-fx-background-color: #e0e1dd; -fx-background-radius: 12 12 0 0; -fx-padding: 25 40 15 40;">
            <effect>
                <DropShadow color="#00000044" radius="20" spread="0.08"/>
            </effect>
            <Label text="Sound Engineer" textFill="#415a77">
                <font><Font name="System Bold" size="13.0"/></font>
            </Label>
            <Label text="Live Sound Monitor Dashboard" textFill="#0d1b2a">
                <font><Font name="System Bold Italic" size="26.0"/></font>
            </Label>
            <Separator prefWidth="920.0" style="-fx-padding: 4 0 0 0;"/>
        </VBox>

        <!-- Main Content Card -->
        <VBox spacing="20.0"
              style="-fx-background-color: #e0e1dd; -fx-background-radius: 0 0 12 12; -fx-padding: 30 40 35 40;">
            <effect>
                <DropShadow color="#00000044" radius="20" spread="0.08"/>
            </effect>

            <!-- Status Banner -->
            <Label fx:id="statusLabel" alignment="CENTER" prefWidth="920.0" wrapText="true"
                   style="-fx-padding: 14; -fx-background-radius: 8; -fx-font-weight: bold; -fx-text-fill: #0d1b2a;"/>

            <HBox spacing="40.0" alignment="TOP_LEFT">

                <!-- Left: Live Channels Table -->
                <VBox spacing="12.0" prefWidth="480.0">
                    <Label text="Live Channel Monitoring" textFill="#0d1b2a" style="-fx-font-weight: bold;">
                        <font><Font name="System Bold" size="15.0"/></font>
                    </Label>
                    <Separator prefWidth="480.0"/>

                    <TableView fx:id="channelTable" prefHeight="320.0" style="-fx-background-color: white;">
                        <columns>
                            <TableColumn fx:id="ChannelColumn" prefWidth="110.0" text="Channel"/>
                            <TableColumn fx:id="LevelColumn" prefWidth="110.0" text="Level (dB)"/>
                            <TableColumn fx:id="StatusColumn" prefWidth="240.0" text="Status"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Right: Adjustment Panel -->
                <VBox spacing="18.0" prefWidth="420.0">
                    <Label text="Channel Adjustment" textFill="#0d1b2a" style="-fx-font-weight: bold;">
                        <font><Font name="System Bold" size="15.0"/></font>
                    </Label>
                    <Separator prefWidth="420.0"/>

                    <GridPane vgap="12.0" hgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="130.0" prefWidth="140.0"/>
                            <ColumnConstraints minWidth="240.0" prefWidth="260.0"/>
                        </columnConstraints>

                        <Label text="Select Channel:" textFill="#1b263b" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <font><Font name="System Bold" size="12.5"/></font>
                        </Label>
                        <ComboBox fx:id="AdjustChannelCombo" prefWidth="260.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="New Level (dB):" textFill="#1b263b" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <font><Font name="System Bold" size="12.5"/></font>
                        </Label>
                        <HBox spacing="8.0" GridPane.rowIndex="1" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                            <TextField fx:id="levelTextField" prefWidth="110.0" promptText="-12.5"/>
                            <Label text="dB" textFill="#415a77" style="-fx-font-weight: bold;"/>
                        </HBox>

                        <Label text="Change Status:" textFill="#1b263b" GridPane.rowIndex="2" GridPane.columnIndex="0">
                            <font><Font name="System Bold" size="12.5"/></font>
                        </Label>
                        <ComboBox fx:id="StatusComboBox" prefWidth="260.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Button fx:id="applyBtn" text="Apply Adjustment"
                            onAction="#HandleApplyAdjustmentButtonOnAction"
                            prefHeight="48.0" prefWidth="280.0"
                            style="-fx-background-color: linear-gradient(to right, #0d1b2a, #415a77);
                                   -fx-text-fill: #e0e1dd; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </VBox>
            </HBox>

            <!-- Action Buttons -->
            <HBox spacing="15.0" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="saveLogsBtn" text="Save Logs"
                        onAction="#HandleSaveLogsButtonOnAction"
                        prefHeight="42.0" prefWidth="160.0"
                        style="-fx-background-color: linear-gradient(to right, #0d1b2a, #415a77);
                               -fx-text-fill: #e0e1dd; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

                <Button text="Load Data"
                        onAction="#HandleLoadLogsButtonOnAction"
                        prefHeight="42.0" prefWidth="140.0"
                        style="-fx-background-color: #415a77; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

                <Button text="Clear Adjustments"
                        onAction="#handleClear"
                        prefHeight="42.0" prefWidth="160.0"
                        style="-fx-background-color: #757575; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
            </HBox>

            <!-- Footer Navigation -->
            <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-padding: 15 0 0 0;">
                <Button onAction="#DashboardButtonOnAction" prefHeight="40.0" prefWidth="180.0"
                        style="-fx-background-color: #1b263b; -fx-text-fill: #e0e1dd;
                               -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="← Back to Dashboard"/>
            </HBox>
        </VBox>

        <!-- Copyright -->
        <Label text="© 2026 Music Band OOP System | Live Sound Monitoring Module"
               textFill="#e0e1dd88" style="-fx-padding: 12 0 0 0;">
            <font><Font size="11.0"/></font>
        </Label>

    </VBox>
</AnchorPane>