<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="800.0" prefWidth="1100.0"
             style="-fx-background-color: linear-gradient(to bottom right, #0d1b2a, #1b263b, #415a77);"
             xmlns="http://javafx.com/javafx/23"
             xmlns:fx="http://javafx.com/fxml/1"
             fx:controller="com.example.music_band_oop.Controller.FXMLControllerForUser1.SE_Goal8_ViewController">

<VBox alignment="CENTER" layoutX="50.0" layoutY="25.0" prefWidth="1000.0" spacing="0.0">

    <!-- Header Card -->
    <VBox alignment="CENTER" spacing="6.0"
          style="-fx-background-color: #e0e1dd; -fx-background-radius: 12 12 0 0; -fx-padding: 25 40 15 40;">
        <effect>
            <DropShadow color="#00000044" radius="20" spread="0.08"/>
        </effect>
        <Label text="Sound Engineer" textFill="#415a77">
            <font><Font name="System Bold" size="13.0"/></font>
        </Label>
        <Label text="Recording &amp; Feedback Dashboard" textFill="#0d1b2a">
            <font><Font name="System Bold Italic" size="26.0"/></font>
        </Label>
        <Separator prefWidth="920.0" style="-fx-padding: 4 0 0 0;"/>
        <Label text="Log show recordings, track audio quality, and archive engineer feedback."
               textFill="#415a77" wrapText="true" alignment="CENTER">
            <font><Font size="12.0"/></font>
        </Label>
    </VBox>

    <!-- Content Card -->
    <VBox spacing="18.0"
          style="-fx-background-color: #e0e1dd; -fx-background-radius: 0 0 12 12; -fx-padding: 25 40 30 40;">
        <effect>
            <DropShadow color="#00000044" radius="20" spread="0.08"/>
        </effect>

        <!-- Status Banner -->
        <Label fx:id="StatusLabel" alignment="CENTER" prefWidth="920.0" wrapText="true"
               visible="false" managed="false"
               style="-fx-padding: 12; -fx-background-radius: 6; -fx-font-weight: bold;"/>

        <!-- Form Section -->
        <HBox spacing="35.0" alignment="TOP_CENTER">

            <!-- Left: Show Info -->
            <VBox spacing="12.0" prefWidth="440.0">
                <Label text="Show Information" textFill="#0d1b2a">
                    <font><Font name="System Bold" size="15.0"/></font>
                </Label>
                <Separator prefWidth="440.0"/>

                <GridPane vgap="10.0" hgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120.0" prefWidth="130.0"/>
                        <ColumnConstraints minWidth="270.0" prefWidth="300.0"/>
                    </columnConstraints>

                    <Label text="Show Title:*" textFill="#1b263b" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <TextField fx:id="TitleTextField" promptText="e.g., Rock Night 2026, Jazz Fest"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Engineer Name:*" textFill="#1b263b" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <TextField fx:id="EngineerTextField" promptText="Lead engineer on duty"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Recording Date:*" textFill="#1b263b" GridPane.rowIndex="2" GridPane.columnIndex="0">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <DatePicker fx:id="RecordingDatePicker" promptText="YYYY-MM-DD"
                                prefWidth="300.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Duration:" textFill="#1b263b" GridPane.rowIndex="3" GridPane.columnIndex="0">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <TextField fx:id="DurationTextField" promptText="e.g., 1:45:30"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Right: Technical Details -->
            <VBox spacing="12.0" prefWidth="440.0">
                <Label text="Technical Details" textFill="#0d1b2a">
                    <font><Font name="System Bold" size="15.0"/></font>
                </Label>
                <Separator prefWidth="440.0"/>

                <GridPane vgap="10.0" hgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120.0" prefWidth="130.0"/>
                        <ColumnConstraints minWidth="270.0" prefWidth="300.0"/>
                    </columnConstraints>

                    <Label text="Quality Rating:*" textFill="#1b263b" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <ComboBox fx:id="QualityComboBox" promptText="Select quality rating"
                              prefWidth="300.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="File Location:" textFill="#1b263b" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextField fx:id="FileLocationTextField" promptText="/recordings/show_001.wav"
                                   prefWidth="230.0" HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handleBrowseFile" text="Browse"
                                style="-fx-background-color: #415a77; -fx-text-fill: #e0e1dd; -fx-cursor: hand;"/>
                    </HBox>

                    <Label text="Feedback / Notes:*" textFill="#1b263b" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="TOP">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <TextArea fx:id="FeedbackandNotesTextField" promptText="Mix notes, issues, audience feedback, post-show review..."
                              prefHeight="80.0" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>
        </HBox>

        <!-- Action Buttons -->
        <HBox spacing="12.0" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
            <Button onAction="#SaveToTableButtonOnAction" prefHeight="42.0" prefWidth="160.0"
                    style="-fx-background-color: linear-gradient(to right, #0d1b2a, #415a77); -fx-text-fill: #e0e1dd; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Add Recording">
                <font><Font size="13.0"/></font>
            </Button>
            <Button onAction="#handleUpdate" prefHeight="42.0" prefWidth="120.0"
                    style="-fx-background-color: #ef6c00; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Update">
                <font><Font size="13.0"/></font>
            </Button>
            <Button onAction="#handleDelete" prefHeight="42.0" prefWidth="140.0"
                    style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Delete Selected">
                <font><Font size="13.0"/></font>
            </Button>
            <Button onAction="#handleClear" prefHeight="42.0" prefWidth="120.0"
                    style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Clear">
                <font><Font size="13.0"/></font>
            </Button>
        </HBox>

        <!-- Search & Table -->
        <VBox spacing="8.0">
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Recording Log" textFill="#0d1b2a">
                    <font><Font name="System Bold" size="15.0"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Search by title or engineer..." prefWidth="220.0"/>
                <Button onAction="#handleSearch" text="Search" prefWidth="70.0"/>
                <Button onAction="#handleResetSearch" text="Reset" prefWidth="70.0"/>
            </HBox>
            <Separator prefWidth="920.0"/>

            <TableView fx:id="RecordingTableView" prefHeight="220.0" prefWidth="920.0">
                <columns>
                    <TableColumn fx:id="TimeCol" prefWidth="110.0" text="Timestamp"/>
                    <TableColumn fx:id="TitleCol" prefWidth="140.0" text="Show Title"/>
                    <TableColumn fx:id="EngineerCol" prefWidth="110.0" text="Engineer"/>
                    <TableColumn fx:id="DateCol" prefWidth="90.0" text="Date"/>
                    <TableColumn fx:id="DurationCol" prefWidth="70.0" text="Duration"/>
                    <TableColumn fx:id="QualityCol" prefWidth="80.0" text="Quality"/>
                    <TableColumn fx:id="LocationCol" prefWidth="130.0" text="File Location"/>
                    <TableColumn fx:id="FeedbackNotesCol" prefWidth="190.0" text="Feedback / Notes"/>
                </columns>
                <placeholder>
                    <Label text="No recordings logged. Add a show recording using the form above."/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Status Bar -->
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              style="-fx-background-color: #f5f5f5; -fx-background-radius: 6; -fx-padding: 10 15;">
            <Label text="Total Recordings:" textFill="#555555">
                <font><Font name="System Bold" size="11.0"/></font>
            </Label>
            <Label fx:id="recordCountLabel" text="0" textFill="#0d1b2a">
                <font><Font name="System Bold" size="11.0"/></font>
            </Label>
            <Separator orientation="VERTICAL" prefHeight="16.0"/>
            <Label text="Excellent:" textFill="#555555">
                <font><Font name="System Bold" size="11.0"/></font>
            </Label>
            <Label fx:id="excellentCountLabel" text="0" textFill="#2e7d32">
                <font><Font name="System Bold" size="11.0"/></font>
            </Label>
            <Separator orientation="VERTICAL" prefHeight="16.0"/>
            <Label text="Poor/Unusable:" textFill="#555555">
                <font><Font name="System Bold" size="11.0"/></font>
            </Label>
            <Label fx:id="poorCountLabel" text="0" textFill="#c62828">
                <font><Font name="System Bold" size="11.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Recording Module v2.1 | Ready" textFill="#415a77">
                <font><Font size="11.0"/></font>
            </Label>
        </HBox>
    </VBox>

    <!-- Footer Navigation -->
    <HBox alignment="CENTER_RIGHT" prefWidth="1000.0">
        <VBox.margin>
            <Insets top="15.0"/>
        </VBox.margin>
        <Button onAction="#DashboardButtonOnAction" prefHeight="38.0" prefWidth="160.0"
                style="-fx-background-color: #1b263b; -fx-text-fill: #e0e1dd; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                text="← Back to Dashboard">
            <font><Font size="12.0"/></font>
        </Button>
    </HBox>

    <Label text="© 2026 Music Band OOP System | Recording &amp; Feedback Module" textFill="#e0e1dd88">
        <font><Font size="11.0"/></font>
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Label>
</VBox>
</AnchorPane>